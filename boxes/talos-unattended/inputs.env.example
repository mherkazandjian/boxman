# Private inputs for boxes/talos-unattended. Copy to inputs.env (git-ignored),
# replace every PLACEHOLDER and keep the copy out of version control:
#
#   cp inputs.env.example inputs.env && chmod 600 inputs.env
#
# The same file is read by `boxman` on the host (conf.yml) and by
# scripts/gen-config.sh on the control VM. Nothing here is a credential, but
# it describes your site: treat it as private.
#
# Versions and checksums are not set here: versions.env holds the tested set
# (Talos release, ISO, installer image, Kubernetes, talosctl, kubectl, flux).
# Setting one of its variables here overrides that pin, and gen-config.sh
# logs the override; do it only to test another set.

# ---- host side: conf.yml and the install driver ----------------------------
# project name (domains, networks); change it for a second lab beside a first
#TALOS_PROJECT=talos_unattended
# false for a user in the libvirt group, who reaches qemu:///system without sudo
#TALOS_LIBVIRT_USE_SUDO=true
# boxman workspace for this project (VM disks, ssh config, inventories)
TALOS_LAB_DIR=PLACEHOLDER-absolute-path-for-the-workspace
# first three octets of the dedicated NAT network; .1 is the host, .5 the
# Kubernetes VIP, .11-.13 control planes, .21-.23 workers, .100-.199 dynamic
TALOS_LAB_PREFIX=192.168.53
# operator ssh key: the private key path boxman's ssh_config uses, and the
# public key the control template authorizes. Use a key dedicated to this
# lab: `boxman deprovision --cleanup` deletes the file at this path
TALOS_OPERATOR_KEY=PLACEHOLDER-path-to-private-key
TALOS_OPERATOR_PUBKEY="ssh-ed25519 PLACEHOLDER operator@example"
# node set: full (3 control planes + 3 workers, the default) or smoke
# (cp-01 + worker-01); the control VM is in both
#TALOS_PROFILE=smoke
# where install.sh backs up the cluster identity (secrets bundle, talosconfig,
# journal, kubeconfig): a private directory outside the workspace and outside
# any git checkout, so a destroy cannot take it
TALOS_BACKUP_DIR=PLACEHOLDER-absolute-path-for-the-backup

# ---- control side: scripts/gen-config.sh -----------------------------------
# private, durable state on the control VM: secrets bundle, configs,
# talosconfig. Must not be inside a git checkout; back it up off the VM.
TALOS_STATE_DIR=PLACEHOLDER-absolute-path-on-the-control-vm
TALOS_CLUSTER_NAME=talos-unattended
# the one boot disk boxman creates for each node; preflight accepts no other
TALOS_INSTALL_DISK=/dev/vda
# shared control-plane VIP for the Kubernetes API, outside the DHCP range
TALOS_VIP=192.168.53.5
# NTP servers reachable from the fabric network (space separated)
TALOS_NTP_SERVERS="PLACEHOLDER-ntp-server"
TALOS_POD_CIDR=10.244.0.0/16
TALOS_SERVICE_CIDR=10.96.0.0/12
# optional: a directory with all.yaml, controlplane.yaml, worker.yaml or
# <node>.yaml machine-config patches
#TALOS_PATCH_DIR=

# ---- Flux (optional) -----------------------------------------------------------
# off by default. TALOS_FLUX=on bootstraps Flux into an EXISTING GitLab
# project (it is never created) and needs every value below; the credential
# is read from the environment, so export GITLAB_TOKEN rather than writing it
# here
#TALOS_FLUX=on
#GITLAB_HOST=gitlab.example.com
#GITLAB_OWNER=PLACEHOLDER-group-or-user
#GITOPS_REPOSITORY=PLACEHOLDER-project
#GITOPS_BRANCH=main
#GITOPS_CLUSTER_PATH=./clusters/PLACEHOLDER-cluster
#GITLAB_PERSONAL=false
