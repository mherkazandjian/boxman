# The tested version set for boxes/talos-unattended: public release data
# only, nothing site-specific. conf.yml (rendered by boxman on the host) and
# scripts/gen-config.sh (on the control VM) both read this file. A variable
# of the same name in the environment, or in gen-config's --inputs file,
# overrides a pin; gen-config logs every override.
#
# Format: KEY=value lines and comments only. No quotes, no expansion, no
# trailing comments, so Jinja and the shell read it identically.
#
# Recorded 2026-11-02. Where each value came from:

# Talos v1.14.5, the latest stable release (2026-10-26):
#   https://github.com/siderolabs/talos/releases/tag/v1.14.5
TALOS_VERSION=v1.14.5
# talosctl-linux-amd64 from that release: the line in the release's
# sha256sum.txt, equal to the asset digest GitHub lists and to the sha256 of
# the downloaded binary (`talosctl version --client` says Tag v1.14.5)
TALOSCTL_SHA256=ff432b68986709e6b69c563a08a2ced4232d5196b0dccd6d2e783e9d714d7d7d

# Image Factory schematic with exactly one customization,
#   customization: {systemExtensions: {officialExtensions: [siderolabs/qemu-guest-agent]}}
# The id is the content hash https://factory.talos.dev/schematics returns for
# it; /version/v1.14.5/extensions/official lists the extension for v1.14.5.
TALOS_SCHEMATIC_ID=ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515
# Boot ISO built from that schematic. The factory publishes no checksum: this
# is the sha256 of the file downloaded on 2026-11-02 (366292992 bytes).
TALOS_ISO_URI=https://factory.talos.dev/image/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515/v1.14.5/metal-amd64.iso
TALOS_ISO_CHECKSUM=sha256:36723c65c3836e3915f8d4c38f788f8ee8d747787f609b3f02f3eca0711e36c1
# Installer image from the same schematic, so the guest agent survives the
# install, pinned to the image-index digest the factory registry returned for
# the tag (Docker-Content-Digest of /v2/metal-installer/<id>/manifests/v1.14.5).
# `talosctl gen config --help` names factory.talos.dev/metal-installer as
# v1.14.5's installer repository.
TALOS_INSTALLER_IMAGE=factory.talos.dev/metal-installer/ce4c980550dd2ab1b17bbf2b08801c7eb59418eafe8f279833297925d67c7515:v1.14.5@sha256:8a5109843e293b8349ec6e96e8d2f6bc2e77abbf38eee949b535b0cc5538af25

# Kubernetes 1.37.1: talosctl v1.14.5's default (`talosctl gen config
# --help`, `talosctl image default`); Talos 1.14 supports Kubernetes
# 1.33-1.37 (docs.siderolabs.com/talos/v1.14/getting-started/support-matrix).
KUBERNETES_VERSION=1.37.1
# kubectl at the cluster's version: dl.k8s.io/release/v1.37.1/bin/linux/amd64/
# kubectl.sha256, equal to the sha256 of the downloaded binary.
KUBECTL_VERSION=v1.37.1
KUBECTL_SHA256=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
# flux v2.10.0, the latest release (2026-10-26); its notes list Kubernetes
# 1.35-1.37 as supported. flux_2.10.0_linux_amd64.tar.gz: the line in
# flux_2.10.0_checksums.txt, equal to GitHub's asset digest and the download.
FLUX_VERSION=v2.10.0
FLUX_SHA256=208dd7012c04fedeed5b2d0b6e63df3b15b1c34a381527811685c098bc9f8659
